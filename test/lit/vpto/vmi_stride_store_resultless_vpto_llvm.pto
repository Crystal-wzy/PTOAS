// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --vpto-lowering-strategy=no-post-update --emit-vpto %s -o - | FileCheck %s --check-prefix=VPTO
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --vpto-lowering-strategy=no-post-update --emit-vpto-llvm-ir %s -o - | FileCheck %s --check-prefix=LLVM

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a5"} {
    func.func @vmi_stride_store_resultless(
        %value: !pto.vmi.vreg<64xf32>,
        %dst: !pto.ptr<f32, ub>,
        %offset: index,
        %mask: !pto.vmi.mask<64xpred>) attributes {pto.entry} {
      %c2 = arith.constant 2 : i16
      %c0 = arith.constant 0 : i16
      pto.vmi.vstore %value, %dst[%offset], %c2, %c0, %mask
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
      return
    }
  }
}

// VPTO-LABEL: func.func @vmi_stride_store_resultless(
// VPTO: pto.vsstb {{.*}}!pto.mask<b32>{{$}}
// VPTO-NOT: pto.vsstb {{.*}} -> !pto.ptr

// LLVM-LABEL: define void @vmi_stride_store_resultless_mix_aiv
// LLVM: call void @llvm.hivm.vsstb.v64f32
// LLVM-NOT: @llvm.hivm.vsstb.post
