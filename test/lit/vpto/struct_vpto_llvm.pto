// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s
// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

// Stack-local structs must reach the VPTO LLVM pipeline. The nested access
// proves each path element is lowered to an aggregate GEP before the scalar
// store/load, rather than merely passing PTO frontend verification.
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @struct_vpto_llvm() attributes {pto.kernel} {
    %i32 = arith.constant 7 : i32
    %f32 = arith.constant 3.5 : f32
    %i16 = arith.constant 9 : i16
    %s = pto.declare_struct -> !pto.struct<i32, !pto.struct<f32, i16>>
    pto.struct_set %s[0], %i32 : !pto.struct<i32, !pto.struct<f32, i16>>, i32
    pto.struct_set %s[1, 0], %f32 : !pto.struct<i32, !pto.struct<f32, i16>>, f32
    pto.struct_set %s[1, 1], %i16 : !pto.struct<i32, !pto.struct<f32, i16>>, i16
    %value = pto.struct_get %s[1, 0] : !pto.struct<i32, !pto.struct<f32, i16>> -> f32
    pto.struct_set %s[1, 0], %value : !pto.struct<i32, !pto.struct<f32, i16>>, f32
    return
  }
}

// CHECK-LABEL: define {{.*}} @struct_vpto_llvm_mix_aiv()
// CHECK: alloca { i32, { float, i16 } }, i64 1
// CHECK: getelementptr { i32, { float, i16 } }, ptr {{.*}}, i32 0, i32 0
// CHECK: store i32 7, ptr
// CHECK: getelementptr { i32, { float, i16 } }, ptr {{.*}}, i32 0, i32 1
// CHECK: getelementptr { float, i16 }, ptr {{.*}}, i32 0, i32 0
// CHECK: store float 3.500000e+00, ptr
// CHECK: getelementptr { float, i16 }, ptr {{.*}}, i32 0, i32 1
// CHECK: store i16 9, ptr
// CHECK: getelementptr { float, i16 }, ptr {{.*}}, i32 0, i32 0
// CHECK: load float, ptr
