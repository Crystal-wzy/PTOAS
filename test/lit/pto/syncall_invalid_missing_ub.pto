// RUN: not ptoas %s 2>&1 | FileCheck %s

module {
  func.func @bad_syncall(%gm: !pto.partition_tensor_view<64xi32>) {
    pto.syncall(%gm : !pto.partition_tensor_view<64xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

// CHECK: error: custom op 'pto.syncall' expects soft AIV-only syncall to have gm_workspace, ub_workspace, and optional used_cores
