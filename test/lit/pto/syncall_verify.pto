// RUN: ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @valid_workspaces(
      %exact: memref<16xi32, #pto.address_space<gm>>,
      %multidim: memref<4x4xi32, #pto.address_space<gm>>,
      %dynamic: memref<?xi32, #pto.address_space<gm>>,
      %tensor_view: !pto.tensor_view<16xi32>,
      %partition_view: !pto.partition_tensor_view<16xi32>) {
    pto.syncall(%exact : memref<16xi32, #pto.address_space<gm>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall(%multidim : memref<4x4xi32, #pto.address_space<gm>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aic_only>
    pto.syncall(%dynamic : memref<?xi32, #pto.address_space<gm>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    pto.syncall(%tensor_view : !pto.tensor_view<16xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall(%partition_view : !pto.partition_tensor_view<16xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aic_only>
    return
  }
}

// CHECK-LABEL: func.func @valid_workspaces(
// CHECK-COUNT-5: pto.syncall(
