// RUN: split-file %s %t
// RUN: not ptoas %t/missing_gm.pto 2>&1 | FileCheck %s --check-prefix=MISSING-GM
// RUN: not ptoas %t/legacy_operands.pto 2>&1 | FileCheck %s --check-prefix=LEGACY
// RUN: not ptoas %t/small_capacity.pto 2>&1 | FileCheck %s --check-prefix=SMALL
// RUN: not ptoas %t/wrong_element_type.pto 2>&1 | FileCheck %s --check-prefix=ELEM
// RUN: not ptoas %t/wrong_address_space.pto 2>&1 | FileCheck %s --check-prefix=SPACE
// RUN: not ptoas %t/wrong_used_cores_type.pto 2>&1 | FileCheck %s --check-prefix=USED

// MISSING-GM: error: custom op 'pto.syncall' expects soft syncall to have gm_workspace and optional used_cores
// LEGACY: error: custom op 'pto.syncall' expects soft syncall to have gm_workspace and optional used_cores
// SMALL: error: 'pto.syncall' op expects gm_workspace to contain at least 16 i32 elements (64 bytes), but static capacity is 15
// ELEM: error: 'pto.syncall' op expects gm_workspace element type to be i32
// SPACE: error: 'pto.syncall' op expects gm_workspace to be in GM address space
// USED: error: 'pto.syncall' op operand #1 must be 32-bit signless integer

//--- missing_gm.pto
module {
  func.func @missing_gm() {
    pto.syncall() mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

//--- legacy_operands.pto
module {
  func.func @legacy_operands(%gm: memref<16xi32, #pto.address_space<gm>>,
                             %ub: memref<64xi32, #pto.address_space<vec>>,
                             %used: i32) {
    pto.syncall(%gm, %ub, %used : memref<16xi32, #pto.address_space<gm>>, memref<64xi32, #pto.address_space<vec>>, i32) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

//--- small_capacity.pto
module {
  func.func @small_capacity(%gm: memref<15xi32, #pto.address_space<gm>>) {
    pto.syncall(%gm : memref<15xi32, #pto.address_space<gm>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

//--- wrong_element_type.pto
module {
  func.func @wrong_element_type(%gm: memref<16xf32, #pto.address_space<gm>>) {
    pto.syncall(%gm : memref<16xf32, #pto.address_space<gm>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

//--- wrong_address_space.pto
module {
  func.func @wrong_address_space(%gm: memref<16xi32, #pto.address_space<vec>>) {
    pto.syncall(%gm : memref<16xi32, #pto.address_space<vec>>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}

//--- wrong_used_cores_type.pto
module {
  func.func @wrong_used_cores_type(
      %gm: memref<16xi32, #pto.address_space<gm>>, %used: index) {
    pto.syncall(%gm, %used : memref<16xi32, #pto.address_space<gm>>, index) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}
