// RUN: pto-test-opt --pto-view-to-memref --pto-plan-memory %s | FileCheck %s

// Guard: shared view lowering and memory planning must visit executable
// functions in both EmitC and VPTO child modules.

module {
  module attributes {pto.backend = "emitc"} {
    func.func private @consume_emitc(%arg0: !pto.ptr<f32, ub>)
    func.func @emitc_kernel() {
      %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf32>
      %ptr = pto.tile_buf_addr %tile
          : !pto.tile_buf<vec, 1x16xf32> -> !pto.ptr<f32, ub>
      func.call @consume_emitc(%ptr) : (!pto.ptr<f32, ub>) -> ()
      return
    }
  }

  module attributes {pto.backend = "vpto"} {
    func.func private @consume_vpto(%arg0: !pto.ptr<f32, ub>)
    func.func @vpto_kernel() {
      %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf32>
      %ptr = pto.tile_buf_addr %tile
          : !pto.tile_buf<vec, 1x16xf32> -> !pto.ptr<f32, ub>
      func.call @consume_vpto(%ptr) : (!pto.ptr<f32, ub>) -> ()
      return
    }
  }
}

// CHECK-LABEL: func.func @emitc_kernel
// CHECK: pto.pointer_cast
// CHECK: memref<?xf32
// CHECK-LABEL: func.func @vpto_kernel
// CHECK: pto.pointer_cast
// CHECK: memref<?xf32
// CHECK-NOT: pto.alloc_tile
// CHECK-NOT: pto.tile_buf_addr
