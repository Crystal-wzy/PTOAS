module {
  func.func @syncall_binding_kernel(%arg0: !pto.ptr<i32, gm>, %arg1: i32) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c16], strides = [%c1] : !pto.tensor_view<16xi32>
    %1 = pto.partition_view %0, offsets = [%c0], sizes = [%c16] : !pto.tensor_view<16xi32>
    pto.syncall(%1, %arg1 : !pto.partition_tensor_view<16xi32>, i32) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}
